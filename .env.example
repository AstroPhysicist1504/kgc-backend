# ─────────────────────────────────────────────
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to GitHub.
# ─────────────────────────────────────────────

# Supabase → Project Settings → Database → Connection string → "URI"
# Use the "Session pooler" or "Direct connection" string, e.g.:
# postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Any long random string — used to sign login sessions (JWTs).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# How long a login session stays valid before requiring re-login
JWT_EXPIRES_IN=12h

# Port the backend server listens on
PORT=4000

# Comma-separated list of frontend URLs allowed to call this API
# e.g. http://localhost:5500,https://your-live-site.com
ALLOWED_ORIGINS=http://localhost:5500
